{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputImages",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::itc5205-yolo-250014/input/*"
    },
    {
      "Sid": "WriteResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::itc5205-yolo-250014/output/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::itc5205-yolo-250014"
    },
    {
      "Sid": "WriteDetections",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:209340830629:table/itc5205-yolo-detections"
    }
  ]
}
